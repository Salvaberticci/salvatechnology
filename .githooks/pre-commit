#!/bin/sh
# Pre-commit: bloquea commits que contengan claves/tokens de API.
# Corre localmente antes de cada commit. Si detecta un secreto, aborta.

PATTERN='gsk_[A-Za-z0-9]{25,}|AIza[A-Za-z0-9_\-]{25,}|AQ\.[A-Za-z0-9_\-]{25,}|sk-(live|test|proj)-[A-Za-z0-9]{15,}|ghp_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}'

# Recorre archivos staged y detecta secretos en texto plano
git diff --cached --name-only -z | tr '\0' '\n' | while IFS= read -r file; do
    case "$file" in
        *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.ttf|*.woff*|*.pdf|*.sqlite*) continue ;;
    esac
    if [ -f "$file" ]; then
        hit=$(grep -nEo "$PATTERN" "$file" | head -n1)
        if [ -n "$hit" ]; then
            printf '\033[0;31mSECRETO DETECTADO en "%s": %s...\nCommit ABORTADO. Pon la clave en config/keys.local.php (gitignored).\033[0m\n' "$file" "$(echo "$hit" | cut -c1-24)"
            exit 1
        fi
    fi
done || exit 1
exit 0